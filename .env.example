# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=alfurqancollege.com.ng,www.alfurqancollege.com.ng
DJANGO_CSRF_TRUSTED_ORIGINS=https://alfurqancollege.com.ng,https://www.alfurqancollege.com.ng
SITE_URL=https://alfurqancollege.com.ng

# Database (default SQLite). For PostgreSQL:
# DATABASE_ENGINE=postgresql
# DB_NAME=alfurqan
# DB_USER=alfurqan
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Payment gateways (secrets live here, not in the database)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
ALLOW_SANDBOX_GATEWAY=false

# E-mail notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@alfurqancollege.com.ng
